.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment & secrets
.env
*.env
config_local.json

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak

# Claude Code worktrees
.claude/worktrees/

# Build artifacts (frontend)
frontend/dist/
static/

# Claude Code internals (config, memory, transcripts)
.claude/

# E2E remote test configs (may contain API keys)
tests/e2e_remote/

# Keys & certificates
keys/
*.pem
*.key
*.p12
*.pfx

# Database files
*.db
*.sqlite
*.sqlite3


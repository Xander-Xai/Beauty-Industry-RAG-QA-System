# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
.venv-ragas/
venv/
env/

# Model directories (large files - use Git LFS or external storage)
chatglm3-6b/
blip-image-captioning-large/
roberta-base/
all-MiniLM-L6-v2/
ms-marco-TinyBERT-L-2-v2/
tinybert/

# Data & cache
.cache/
*.cache
milvus/
data/
!data/__init__.py
!data/mock_generator.py
# Offline pipeline source modules are tracked; only generated artifacts are ignored.
offline/*.pt
offline/*.bin
offline/*.safetensors
offline/*.onnx
offline/data/
offline/output/
offline/.offline_state.sqlite3
# Agent-tool working directories. Everything under them is tool output — brainstorm
# decks, session state, transcripts — not repository content. See the equivalent
# `.claude/` entry below.
.superpowers/
.claude/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment & secrets
.env
*.env
config_local.json
# Bearer token for the authenticated /api/metrics scrape. deploy/prometheus.yml
# tells operators to mint it into this path and keep it out of version control;
# without an ignore rule `git add -A` would commit a live credential.
deploy/prometheus-token

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak

# Claude Code worktrees
.claude/worktrees/

# Build artifacts (frontend)
frontend/dist/
static/

# E2E remote test configs (may contain API keys)
tests/e2e_remote/

# Keys & certificates
keys/
*.pem
*.key
*.p12
*.pfx

# Database files
*.db
*.sqlite
*.sqlite3

# Local working notes (not for public repo). PRD.md is deliberately NOT ignored:
# it is tracked and linked from README.md as the product/architecture design
# document, so its truth markers are part of the published evidence surface.
AUDIT_REPORT.md

# Coverage output
.coverage
__pycache__/

# Generated benchmark artifacts. The contract README in each directory is
# tracked; measured runs are never committed from a local machine.
artifacts/benchmarks/*
!artifacts/benchmarks/README.md
artifacts/performance/*
!artifacts/performance/README.md

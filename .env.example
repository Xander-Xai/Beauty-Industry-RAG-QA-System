# ============================================================================
# RAG QA System - Environment Variables
# ============================================================================
# Copy this file to .env and adjust values for your deployment.
# ============================================================================

# ── General ───────────────────────────────────────────────────────────────
CONFIG_PATH=./config.json
SERVICE_NAME=api-gateway
LOG_LEVEL=INFO

# ── Authentication ────────────────────────────────────────────────────────
# Primary browser auth is RS256: configure JWT_PRIVATE_KEY_PATH /
# JWT_PUBLIC_KEY_PATH / JWT_ALGORITHM (see the JWT (RS256) section below).
# JWT_SECRET is the legacy HS256 compatibility secret and is only needed to keep
# verifying older HS256 tokens. RS256 verification does not depend on it; leave
# it empty to run RS256-only. If you do set it, use a strong random value
# (min 32 chars) via: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# Safe default: production-like auth. Set to true only for local header-based impersonation.
AUTH_DEV_MODE=false
SERVICE_AUTH_TOKEN=REPLACE_WITH_RANDOM_32_CHARS

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origin list. Leave empty for development (allows all).
# Production: must be set to specific frontend URL(s)
CORS_ORIGINS=

# API Gateway title (shown in OpenAPI docs)
API_GATEWAY_TITLE=RAG QA System API Gateway

# ── Frontend ──────────────────────────────────────────────────────────────
# Browser-facing API root. Empty value means same-origin, useful behind nginx.
VITE_API_BASE_URL=
# Optional browser tab title fallback; runtime UI labels come from /api/auth/metadata.
VITE_APP_TITLE=Beauty Knowledge RAG Assistant

# ── Service URLs (Docker Compose overrides automatically) ────────────────
API_GATEWAY_URL=http://api-gateway:8000
REWRITE_SERVICE_URL=http://rewrite-service:8101
RETRIEVAL_SERVICE_URL=http://retrieval-service:8200
GENERATION_SERVICE_URL=http://generation-service:8100
CACHE_SERVICE_URL=http://cache-service:8300
MONITORING_SERVICE_URL=http://monitoring-service:8400

# ── API Ports (for standalone/local runs) ────────────────────────────────
API_PORT=8000
API_GATEWAY_PORT=8000
RETRIEVAL_SERVICE_PORT=8200

# ── vLLM Endpoint URLs (override default http://localhost:<port>) ──
VLLM_4B_URL=http://localhost:8101
VLLM_GEN_14B_URL=http://localhost:8100
# Per-attempt timeout. Each attempt's timeout is additionally clamped to the
# request deadline still remaining, so raising this cannot extend a request
# past VLLM_GENERATION_DEADLINE_SECONDS.
VLLM_TIMEOUT_SECONDS=10.0
# ── vLLM generation resilience (see router/vllm_resilience.py) ──
# Total attempts including the first. Default 2 = 1 initial attempt + at most
# 1 retry. Clamped to [1, 3] — 3 total attempts (at most 2 retries) is the
# structural hard bound, so it cannot be raised into a retry storm by configuration.
VLLM_MAX_ATTEMPTS=2
# Deterministic exponential backoff, capped by VLLM_RETRY_MAX_DELAY_SECONDS.
# There is no random jitter: storm prevention comes from the attempt cap, the
# capped delay and the deadline, all of which are deterministic.
VLLM_RETRY_BASE_DELAY_SECONDS=0.2
VLLM_RETRY_MAX_DELAY_SECONDS=2.0
# Total wall budget for one generation request: every attempt plus every backoff
# sleep. A Retry-After hint longer than VLLM_RETRY_MAX_DELAY_SECONDS is treated
# as "do not retry".
VLLM_GENERATION_DEADLINE_SECONDS=15.0

# ── Model Paths (for local / non-Docker runs) ────────────────────────────
BERT_COMPLEXITY_PATH=./models/bert-complexity
BI_ENCODER_PATH=./models/bge-base-zh-v1.5
CROSS_ENCODER_A_PATH=./models/cross-encoder-law
CROSS_ENCODER_B_PATH=./models/cross-encoder-base
NLI_MODEL_PATH=./models/nli-deberta
CLIP_TEXT_ENCODER_PATH=./models/clip-vit-base-patch16
CLIP_IMAGE_ENCODER_PATH=./models/clip-vit-base-patch16
BLIP_MODEL_PATH=./models/blip-image-captioning-large

# ── Offline ingestion (optional) ─────────────────────────────────────────
# Shared, current-user-private directory for cross-process ingestion locks.
# Leave empty to use the OS temp directory. See docs/data-admin-guide.md.
OFFLINE_INGESTION_LOCK_DIR=
# Real BGE/CLIP weights must be supplied by the operator at the paths above.
# OCR requires the optional runtime: pip install -r offline/requirements-ocr.txt

# ── Qdrant (Vector Database) ────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Elasticsearch ─────────────────────────────────────────────────────────
# ⚠️ Production: set a strong password; docker-compose will reject empty values
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=0
REDIS_CACHE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

REDIS_STATE_HOST=localhost
REDIS_STATE_PORT=6379
REDIS_STATE_DB=1
REDIS_STATE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Docker Compose global Redis password
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── MinIO (for document/media storage) ────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY

# ── Monitoring / Tracing ─────────────────────────────────────────────────
# 追踪钩子始终在主链路上（core/pipeline.py → monitoring/otel_tracer.py）。
# 默认**没有配置任何 exporter**，span 既不导出也不保留，因此后端查不到 span。
#
# 启用 OTLP 导出（可选，默认关闭）:
#   1. pip install -r requirements-otel.txt   # exporter 是可选依赖
#   2. 起一个接收端（可选 overlay）:
#      docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
#   3. 设置下面的变量并重启应用
#
# 失败语义：exporter 初始化失败或后端不可达 **不会** 影响业务请求，
# 只记录一条 warning，并把 rag_otel_exporter_enabled 保持为 0。
# 参见 docs/slo-runbook.md#tracelookup。
OTEL_EXPORT_ENABLED=false
# http/protobuf（默认）或 grpc
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# base endpoint；http exporter 会自行追加 /v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rag-api
# k=v,k2=v2。属于凭据：不会被记录，也不会进入任何 span 属性。
OTEL_EXPORTER_OTLP_HEADERS=

# ── Deployment Mode ──────────────────────────────────────────────────────
DEPLOYMENT_MODE=development  # production | testing | development
MODEL_DIR=./models

# ── JWT (RS256) ───────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=RS256

# ── Security ──────────────────────────────────────────────────────────────
HTTPS_ENABLED=false
RATE_LIMIT_ENABLED=true
# Comma-separated trusted reverse-proxy IPs/CIDRs. When set, the login rate
# limiter resolves the real client IP from X-Forwarded-For (walking right to
# left past trusted proxies). When unset/empty, X-Forwarded-For is ignored and
# the TCP peer address is used. Never leave this open to untrusted clients.
TRUSTED_PROXIES=

# ── Grafana (Docker only) ───────────────────────────────────────────────
# ⚠️ Production: set strong password
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

      "title": "OTLP exporter enabled (0/1)",
      "description": "otel_exporter_enabled — 1 means spans are leaving the process.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rag_otel_exporter_enabled",

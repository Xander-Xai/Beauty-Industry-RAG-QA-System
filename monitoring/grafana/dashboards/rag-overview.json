        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": null,
      "type": "timeseries",
      "title": "Cache hits (L1) / total requests",
      "description": "rag_cache_hit_L1 / rag_cache_total — the canonical collector emits per-level counters, not a precomputed rate. Ratio computed here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rag_cache_hit_L1 / rag_cache_total",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {

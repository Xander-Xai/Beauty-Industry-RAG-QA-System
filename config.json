{
  "deployment_mode": "development",
  "system": {
    "name": "化妆品行业RAG问答系统",
    "version": "2.3.0",
    "dual_gpu": true
  },
  "gpu0": {
    "role": "主生成推理",
    "models": {
      "gen_14b": {
        "name": "Qwen3-14B (4-bit NF4, PEFT-ready)",
        "engine": "vllm",
        "port": 8100,
        "model_path": "./models/Qwen3-14B-Instruct",
        "lora_adapter_path": "./models/Qwen3-14B-QLoRA-adapter",
        "lora_rank": 16,
        "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
        "peft_config": {
          "auto_discover": true
        },
        "quantization_bits": 4,
        "quant_type": "nf4",
        "max_model_len": 8192,
        "gpu_memory_utilization": 0.85,
        "kv_cache_budget_gb": 8.0,
        "max_output_tokens": {
          "regulation": 1024,
          "development": 768,
          "formulation": 768,
          "ingredient": 512,
          "product": 512,
          "general": 512,
          "short": 256
        }
      }
    }
  },
  "gpu1": {
    "role": "控制与轻推理",
    "models": {
      "vllm_rewrite": {
        "name": "Qwen3-4B",
        "engine": "vllm",
        "port": 8101,
        "model_path": "./models/Qwen3-4B-Instruct",
        "max_model_len": 4096,
        "max_tokens": 192
      },
      "vllm_gen_4b": {
        "name": "Qwen3-4B",
        "engine": "vllm",
        "port": 8102,
        "model_path": "./models/Qwen3-4B-Instruct",
        "max_model_len": 4096
      },
      "bert_complexity": {
        "name": "BERT复杂度分类",
        "model_path": "./models/bert-complexity",
        "device": "cuda:1"
      },
      "cross_encoder_a": {
        "name": "法规成分CrossEncoder",
        "model_path": "./models/cross-encoder-law",
        "device": "cuda:1"
      },
      "cross_encoder_b": {
        "name": "通用CrossEncoder",
        "model_path": "./models/cross-encoder-base",
        "device": "cuda:1"
      },
      "nli_model": {
        "name": "NLI蕴含模型",
        "model_path": "./models/nli-deberta",
        "device": "cuda:1"
      },
      "bi_encoder": {
        "name": "BiEncoder编码器",
        "model_path": "./models/bge-base-zh-v1.5",
        "device": "cuda:1"
      },
      "clip_image_encoder": {
        "name": "CLIP图像编码器",
        "model_path": "./models/clip-vit-base-patch16",
        "device": "cuda:1"
      },
      "clip_text_encoder": {
        "name": "CLIP文本编码器",
        "model_path": "./models/clip-vit-base-patch16",
        "device": "cuda:1"
      },
      "blip": {
        "name": "BLIP图像描述",
        "model_path": "./blip-image-captioning-large",
        "device": "cuda:1",
        "trigger_threshold": 0.05,
        "max_images_per_request": 5,
        "cache_ttl_seconds": 3600
      },
      "bert_blip_intent": {
        "name": "BERT BLIP意图分类",
        "model_path": "",
        "device": "cuda:1",
        "num_labels": 2,
        "_comment": "2分类: visual_intent vs non_visual_intent，model_path 为空时回退到规则引擎"
      }
    },
    "rerank_batch_aggregator": {
      "time_window_ms": 15,
      "max_batch_size": 64,
      "max_pair_batch_size": 40
    }
  },
  "embedding": {
    "text": {
      "model_path": "./models/bge-base-zh-v1.5",
      "model_revision": "bge-base-zh-v1.5",
      "dimension": 768,
      "collection": "rag_text_768"
    },
    "image_clip": {
      "model_path": "./models/clip-vit-base-patch16",
      "model_revision": "clip-vit-base-patch16",
      "dimension": 512,
      "collection": "rag_image_512"
    }
  },
  "qdrant": {
    "host": "qdrant",
    "port": 6333,
    "grpc_port": 6334,
    "collections": {
      "rag_text_768": {
        "dimension": 768,
        "distance": "Cosine"
      },
      "rag_image_512": {
        "dimension": 512,
        "distance": "Cosine"
      }
    }
  },
  "elasticsearch": {
    "host": "http://elasticsearch:9200",
    "index": "cosmetics_docs",
    "enabled": true,
    "username": "",
    "password": ""
  },
  "redis": {
    "cache": {
      "host": "redis",
      "port": 6379,
      "db": 0,
      "ttl_seconds": 3600
    },
    "state": {
      "host": "redis",
      "port": 6379,
      "db": 1
    }
  },
  "knowledge_base": {
    "data_dir": "./data",
    "chunk_size": 500,
    "chunk_overlap_ratio": 0.1,
    "embedding_batch_size": 32,
    "image_batch_size": 16,
    "ocr_batch_size": 8,
    "max_document_bytes": 131072,
    "max_binary_document_bytes": 67108864,
    "max_chunks": 256,
    "max_images_per_document": 100,
    "ocr_min_text_chars": 20,
    "pdf_render_dpi": 150,
    "xlsx_rows_per_block": 50,
    "state_db_path": "./data/offline_state.sqlite3",
    "supported_extensions": [".txt", ".pdf", ".docx", ".xlsx", ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tif", ".tiff"],
    "ocr": {
      "engine": "paddleocr",
      "language": "ch",
      "visual_weight_repeat": 3
    }
  },
  "offline": {
    "scheduler": {
      "incremental_enabled": true,
      "full_rebuild_enabled": true,
      "incremental_cron": "0 2 * * 0",
      "full_rebuild_cron": "0 3 1 * *",
      "auto_seal": false
    },
    "validation": {
      "enabled": true
    },
    "feedback": {
      "store_path": "./data/feedback/feedback.sqlite3",
      "output_dir": "./data/feedback"
    }
  },
  "knowledge_version_epoch": "default",
  "query_rewrite": {
    "max_output_tokens": 192,
    "temperature": 0.1,
    "dialog_rounds": 6
  },
  "retrieval": {
    "parallel_paths": {
      "dense_bge": { "enabled": true, "top_k": 50 },
      "bm25_es": { "enabled": true, "top_k": 50 },
      "clip_visual": { "enabled": true, "top_k": 20 },
      "rewrite_variants": { "enabled": true, "top_k": 30 }
    },
    "rrf": {
      "k": 60,
      "weights": { "w_text": 1.0, "w_clip": 1.0, "w_ocr": 0.8 }
    },
    "cross_encoder": {
      "ensemble": true,
      "final_top_k": 10,
      "max_seq_length": 512,
      "p99_sla_ms": 60
    },
    "evidence_gate": {
      "weights": { "w1": 0.4, "w2": 0.2, "w3": 0.2, "w4": 0.2 },
      "thresholds": { "high_confidence": 0.75, "low_confidence": 0.55, "reject": 0.3 }
    }
  },
  "generation": {
    "max_conversation_rounds": 6,
    "prompt_version": "v2.1",
    "answer_gate": { "nli_threshold": 0.6 }
  },
  "prompts": {
    "system_prompt": "",
    "system_prompt_by_business_type": {
      "regulation": "",
      "development": ""
    },
    "_comment": "system_prompt 为空时使用代码内置默认值（行业通用）。在 prompt 中使用 {business_type} 占位符"
  },
  "domain_keywords": {
    "regulation": ["法规", "合规", "标准", "备案", "许可", "标准号", "GB", "禁用"],
    "development": ["配方", "研发", "工艺", "制备", "合成", "开发"],
    "ingredient": ["成分", "INCI", "功效", "浓度", "含量", "添加量"],
    "product": ["产品", "品牌", "适用", "肤质", "包装"],
    "visual": ["图片", "包装", "外观", "照片", "扫描", "标签", "成分表", "配方", "图像", "图像识别", "OCR", "说明书", "瓶身", "外盒"],
    "_comment_visual": "visual 关键词用于 CLIP 图像检索触发判别"
  },
  "model_routing": {
    "tiers": {
      "complex":  { "endpoint": "gen_14b", "label": "复杂/高精度模型" },
      "simple":   { "endpoint": "gen_4b",  "label": "简单/轻量模型" },
      "rewrite":  { "endpoint": "vllm_rewrite", "label": "查询改写" }
    },
    "endpoint_map": {
      "qwen3-4b": "gen_4b",
      "qwen3-14b": "gen_14b",
      "_comment": "上面两个键保持向后兼容。新代码应使用 model_routing.tiers 中的 tier 名"
    },
    "complexity_fallback": "simple"
  },
  "admission_control": {
    "safety_factor": 0.7,
    "kv_pressure_tighten": 0.70,
    "kv_pressure_truncate": 0.80,
    "kv_pressure_soft_stop": 0.90,
    "kv_pressure_critical": 0.95
  },
  "cache_config": {
    "l1_max_entries": 1000,
    "l1_ttl_seconds": 300,
    "l2_ttl_seconds": 3600
  },
  "permission_rules": {
    "_comment": "离线管线根据文件所在路径自动注入 role_mask / dept_mask",
    "rules": [
      { "path_pattern": "**/法规/**", "role_mask": 4, "dept_mask": 4 },
      { "path_pattern": "**/研发/**", "role_mask": 1, "dept_mask": 1 },
      { "path_pattern": "**/质量/**", "role_mask": 2, "dept_mask": 2 },
      { "path_pattern": "**/销售/**", "role_mask": 8, "dept_mask": 8 },
      { "path_pattern": "**/公开/**", "role_mask": 0, "dept_mask": 0 }
    ],
    "default_role_mask": 0,
    "default_dept_mask": 0
  },
  "minio": {
    "endpoint": "minio:9000",
    "access_key": "",
    "secret_key": "",
    "bucket": "rag-media",
    "signed_url_ttl_seconds": 60
  },
  "clip_sync": {
    "timeout_ms": 120,
    "low_cost_top_k": 20
  },
  "clip_async": {
    "enabled": true,
    "top_k": 100,
    "preheat_on_multiturn": true
  },
  "rbac": {
    "roles": {
      "admin": 2147483647,
      "rd": 1,
      "quality": 2,
      "regulation": 4,
      "sales": 8
    },
    "departments": {
      "all": 0,
      "rd_dept": 1,
      "quality_dept": 2,
      "regulation_dept": 4,
      "sales_dept": 8
    },
    "super_admin_mask": 4294967295,
    "public_mask": 0
  },
  "alerting": {
    "rules": [
      {"name": "blip_trigger_high", "metric": "blip_trigger_rate", "threshold": 0.1,
       "duration_s": 300, "severity": "warning", "comparison": "gt"},
      {"name": "cache_hit_L1_drop", "metric": "cache_hit_rate_L1", "threshold": 0.3,
       "duration_s": 300, "severity": "warning", "comparison": "lt"},
      {"name": "rerank_batch_queue_high", "metric": "rerank_batch_queue_delay_p99", "threshold": 50,
       "duration_s": 60, "severity": "warning", "comparison": "gt"},
      {"name": "redis_degraded_long", "metric": "redis.degraded_events", "threshold": 5,
       "duration_s": 300, "severity": "warning", "comparison": "gt"}
    ]
  },
  "monitoring": {
    "jaeger": {
      "enabled": false,
      "agent_host": "localhost",
      "agent_port": 6831
    }
  },
  "auth": {
    "dev_mode": true,
    "jwt_secret": "",
    "jwt_expiry_hours": 24
  },
  "ui": {
    "app_title": "化妆品行业知识问答助手",
    "subtitle": "面向化妆品行业知识库的检索增强问答助手",
    "anonymous_user_id": "web-user",
    "default_role": "public",
    "role_options": [
      { "key": "public", "label": "Public Visitor", "role_mask": 0, "dept_mask": 0 },
      { "key": "admin", "label": "Administrator", "role_mask": 2147483647, "dept_mask": 0 },
      { "key": "rd", "label": "Research and Development", "role_mask": 1, "dept_mask": 1 },
      { "key": "quality", "label": "Quality Assurance", "role_mask": 2, "dept_mask": 2 },
      { "key": "regulation", "label": "Regulatory Affairs", "role_mask": 4, "dept_mask": 4 },
      { "key": "sales", "label": "Commercial Team", "role_mask": 8, "dept_mask": 8 }
    ]
  }
}

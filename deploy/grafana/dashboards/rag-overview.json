{
  "annotations": { "list": [] },
  "editable": true,
  "title": "化妆品 RAG 系统监控",
  "uid": "rag-cosmetics-overview",
  "panels": [
    {
      "title": "QPS (每秒查询数)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(rag_requests_total[1m])", "legendFormat": "QPS" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "延迟分布 (P50/P95/P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rag_latency_p50", "legendFormat": "P50" },
        { "expr": "rag_latency_p95", "legendFormat": "P95" },
        { "expr": "rag_latency_p99", "legendFormat": "P99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "活跃请求数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "rag_active_requests" }]
    },
    {
      "title": "KV Cache 压力",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "rag_kv_pressure" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 0.7 },
        { "color": "red", "value": 0.9 }
      ]}}}
    },
    {
      "title": "缓存命中率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rag_cache_l1_hit_rate", "legendFormat": "L1 命中率" },
        { "expr": "rag_cache_l2_hit_rate", "legendFormat": "L2 命中率" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "title": "Evidence Gate 分数分布",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rag_evidence_score_avg", "legendFormat": "平均分" },
        { "expr": "rag_evidence_gate_pass_rate", "legendFormat": "通过率" }
      ]
    },
    {
      "title": "GPU0 显存使用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "nvidia_gpu_memory_used_bytes{index=\"0\"}", "legendFormat": "已用" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "GPU1 显存使用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "nvidia_gpu_memory_used_bytes{index=\"1\"}", "legendFormat": "已用" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Rewrite 降级率",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
      "targets": [{ "expr": "rag_rewrite_fallback_rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [
        { "color": "green", "value": null },
        { "color": "yellow", "value": 0.05 },
        { "color": "red", "value": 0.15 }
      ]}}}
    },
    {
      "title": "NLI 矛盾比例",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 28 },
      "targets": [{ "expr": "rag_nli_contradiction_rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "title": "降级触发次数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 28 },
      "targets": [{ "expr": "rag_degradation_count" }]
    },
    {
      "title": "Admission 拒绝数",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 28 },
      "targets": [{ "expr": "rag_admission_rejected_total" }]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 38
}
